{
  "name" : "NflAnalyticsDataPull",
  "jobMode" : "SCRIPT",
  "description" : "Nfl Job to pull raw nfl data from NFL python Libraries",
  "role" : "arn:aws:iam::043309367189:role/NflAnalyticsProjectGlueRole",
  "executionProperty" : {
    "maxConcurrentRuns" : 1
  },
  "command" : {
    "name" : "pythonshell",
    "scriptLocation" : "s3://aws-glue-assets-043309367189-us-east-1/scripts/NflAnalyticsDataPull.py",
    "pythonVersion" : "3.9"
  },
  "defaultArguments" : {
    "--BUCKET" : "jack-nfl-analytics-datalake",
    "--enable-job-insights" : "false",
    "--additional-python-modules" : "nflreadpy",
    "--enable-observability-metrics" : "false",
    "--enable-glue-datacatalog" : "",
    "library-set" : "analytics",
    "--job-language" : "python",
    "--TempDir" : "s3://aws-glue-assets-043309367189-us-east-1/temporary/"
  },
  "maxRetries" : 0,
  "allocatedCapacity" : 0,
  "timeout" : 10,
  "maxCapacity" : 0.0625,
  "glueVersion" : "3.0",
  "executionClass" : "STANDARD",
  "sourceControlDetails" : {
    "provider" : "GITHUB",
    "repository" : "nfl-analytics",
    "branch" : "Ingestion-Work",
    "folder" : "ingestion"
  }
}